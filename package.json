{
  "name": "@cogniumhq/ci-gate",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action wrapper for ControlDeck workflows. Gates PRs on skill-driven scans.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cogniumhq/ci-gate.git"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts --license licenses.txt --minify --out dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src __tests__ --ext .ts",
    "verify-dist": "bun run build && git diff --exit-code dist"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  }
}
